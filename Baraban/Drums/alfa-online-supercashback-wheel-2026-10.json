{
  "id": "alfa-online-supercashback-wheel-2026-10",
  "name": "Альфа-Онлайн — Суперкэшбэк (октябрь 2026)",
  "description": "Модуль барабана Альфа-Онлайн по полным capture 02.10.2026. GET wheel-of-fortune возвращает варианты; PUT /accept выбирает winnerOffer; бесплатный повтор — GET reset; платный повтор — POST /offer с order из reconfirmButton.modalView.order, затем GET reset и новый явный PUT /accept.",
  "loginUrl": "https://web.alfabank.ru/marketplace/?loyaltyType=104",
  "archived": false,
  "variables": {
    "basketOfferId": "21871",
    "confirmed": "false",
    "winnerOfferId": "",
    "wheelActionTitle": "Крутить скорее!",
    "reconfirmTitle": "",
    "reconfirmSubtitle": "",
    "reconfirmNeedPaid": "",
    "motivationTitle": "",
    "paidRepeatOrder": "",
    "paidRepeatPurchased": "false"
  },
  "requests": [
    {
      "id": "getWheelOfFortune",
      "name": "Получить варианты призов / статус барабана",
      "method": "GET",
      "url": "https://web.alfabank.ru/api/v1/loyalty-view/wheel-of-fortune?basketOfferId={{basketOfferId}}",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Referer": "https://web.alfabank.ru/marketplace/?loyaltyType=104",
        "X-SCREEN-DIMENSION": "desktop"
      },
      "body": "",
      "captures": {
        "confirmed": "$.confirmed",
        "wheelActionTitle": "$.actionButton.title"
      },
      "autoRun": true,
      "isConfirmation": false
    },
    {
      "id": "getWheelOfFortuneWinner",
      "name": "Получить уже выбранный приз",
      "method": "GET",
      "url": "https://web.alfabank.ru/api/v1/loyalty-view/wheel-of-fortune/winner?basketOfferId={{basketOfferId}}",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Referer": "https://web.alfabank.ru/marketplace/?loyaltyType=104",
        "X-SCREEN-DIMENSION": "desktop"
      },
      "body": "",
      "captures": {
        "winnerOfferId": "$.winnerOffer.id",
        "reconfirmTitle": "$.reconfirmButton.title",
        "reconfirmSubtitle": "$.reconfirmButton.subtitle",
        "reconfirmNeedPaid": "$.reconfirmButton.needPaid",
        "motivationTitle": "$.motivation.title",
        "paidRepeatOrder": "$.reconfirmButton.modalView.order"
      },
      "autoRun": false,
      "isConfirmation": false
    },
    {
      "id": "acceptWheelOfFortune",
      "name": "ПОЛУЧИТЬ приз / запустить барабан",
      "method": "PUT",
      "url": "https://web.alfabank.ru/api/v1/loyalty-view/accept",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/json",
        "Origin": "https://web.alfabank.ru",
        "Referer": "https://web.alfabank.ru/marketplace/?loyaltyType=104",
        "X-SCREEN-DIMENSION": "desktop"
      },
      "body": "{\n  \"basketOfferId\": \"{{basketOfferId}}\",\n  \"type\": \"DRUM\"\n}",
      "captures": {
        "winnerOfferId": "$.winnerOffer.id",
        "reconfirmTitle": "$.reconfirmButton.title",
        "reconfirmSubtitle": "$.reconfirmButton.subtitle",
        "reconfirmNeedPaid": "$.reconfirmButton.needPaid",
        "motivationTitle": "$.motivation.title",
        "paidRepeatOrder": "$.reconfirmButton.modalView.order"
      },
      "autoRun": false,
      "isConfirmation": true
    },
    {
      "id": "buyWheelRepeat",
      "name": "ОПЛАТИТЬ повторную попытку барабана",
      "method": "POST",
      "url": "https://web.alfabank.ru/api/v1/loyalty-view/offer",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/json",
        "Origin": "https://web.alfabank.ru",
        "Referer": "https://web.alfabank.ru/marketplace/?loyaltyType=104",
        "X-SCREEN-DIMENSION": "desktop"
      },
      "body": "{{paidRepeatOrder}}",
      "captures": {
        "wheelActionTitle": "$.button.title"
      },
      "autoRun": false,
      "isConfirmation": true
    }
  ],
  "actions": {
    "prizeOptions": [
      {
        "requestId": "getWheelOfFortune"
      }
    ],
    "state": [
      {
        "requestId": "getWheelOfFortune"
      },
      {
        "requestId": "getWheelOfFortuneWinner",
        "whenVariable": "confirmed",
        "whenEquals": "true",
        "optional": true
      }
    ],
    "claim": [
      {
        "requestId": "acceptWheelOfFortune"
      }
    ],
    "repeat": [
      {
        "requestId": "getWheelOfFortune"
      }
    ],
    "prizeResultRequestId": "getWheelOfFortune",
    "stateResultRequestId": "getWheelOfFortuneWinner",
    "winnerVariable": "winnerOfferId",
    "claimRequiresWinner": false,
    "prizeOptionsLabel": "Получить варианты призов",
    "stateLabel": "Состояние барабана",
    "claimLabel": "Крутить скорее!",
    "claimLabelVariable": "wheelActionTitle",
    "repeatTitleVariable": "reconfirmTitle",
    "repeatSubtitleVariable": "reconfirmSubtitle",
    "repeatNeedPaidVariable": "reconfirmNeedPaid",
    "motivationVariable": "motivationTitle",
    "paidRepeat": [
      {
        "requestId": "buyWheelRepeat"
      }
    ],
    "paidRepeatOrderVariable": "paidRepeatOrder",
    "paidRepeatPurchasedVariable": "paidRepeatPurchased"
  },
  "result": {
    "sourceRequestId": "getWheelOfFortune",
    "itemsPath": "$.offers",
    "drumIdPath": "id",
    "offerIdPath": "",
    "titlePaths": [
      "partner",
      "discount"
    ],
    "winnerVariable": "winnerOfferId",
    "requireOfferId": false,
    "winnerFlagPath": ""
  }
}
