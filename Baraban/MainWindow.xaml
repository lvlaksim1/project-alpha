<Window x:Class="Baraban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Baraban" Height="900" Width="1380" MinHeight="720" MinWidth="1100">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Барабаны" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Перезагрузить модули" Click="ReloadDrums_Click" Margin="0,0,0,6"/>
                <Button Content="Запустить цепочку" Click="RunWorkflow_Click" FontWeight="SemiBold"/>
            </StackPanel>
            <ListBox x:Name="DrumList" SelectionChanged="DrumList_SelectionChanged"/>
        </DockPanel>

        <TabControl Grid.Column="2" x:Name="MainTabs">
            <TabItem Header="Результат">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Переменные: " VerticalAlignment="Center"/>
                        <TextBox x:Name="VariablesText" Width="700" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Применить" Click="ApplyVariables_Click" Margin="8,0,0,0" VerticalAlignment="Top"/>
                    </StackPanel>
                    <DataGrid x:Name="ResultGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" LoadingRow="ResultGrid_LoadingRow"/>
                    <TextBox x:Name="LogText" Grid.Row="2" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Grid>
            </TabItem>

            <TabItem Header="HTTP">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="RequestList" Width="330" SelectionChanged="RequestList_SelectionChanged"/>
                        <ComboBox x:Name="MethodBox" Width="90" Margin="8,0,0,0">
                            <ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/><ComboBoxItem Content="PUT"/><ComboBoxItem Content="PATCH"/><ComboBoxItem Content="DELETE"/>
                        </ComboBox>
                        <Button Content="Сохранить запрос" Click="SaveRequest_Click" Margin="8,0,0,0"/>
                        <Button Content="Отправить запрос" Click="SendRequest_Click" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBox x:Name="UrlText" Grid.Row="1" Margin="0,8,0,8"/>
                    <GroupBox Header="Headers (по одному Header: Value на строку)" Grid.Row="2">
                        <TextBox x:Name="HeadersText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </GroupBox>
                    <GroupBox Header="Body" Grid.Row="3" Margin="0,8,0,0">
                        <TextBox x:Name="BodyText" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </GroupBox>
                    <GroupBox Header="Response" Grid.Row="4" Margin="0,8,0,0">
                        <TextBox x:Name="ResponseText" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Сессия">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Перечитать" Click="ReloadSession_Click"/>
                        <Button Content="Сохранить JSON" Click="SaveSession_Click" Margin="8,0,0,0"/>
                        <Button Content="Импорт Cookie header" Click="ImportCookieHeader_Click" Margin="8,0,0,0"/>
                        <Button Content="Импорт capture ZIP" Click="ImportCaptureZip_Click" Margin="8,0,0,0"/>
                        <Button Content="Очистить сессию" Click="ClearSession_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="SessionText" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Grid>
            </TabItem>

            <TabItem Header="Браузер / вход">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="BrowserUrlText" Width="720" Text="https://link.alfabank.ru/partner-offers/"/>
                        <Button Content="Открыть" Click="OpenBrowser_Click" Margin="8,0,0,0"/>
                        <Button Content="Синхронизировать cookies" Click="SyncCookies_Click" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
